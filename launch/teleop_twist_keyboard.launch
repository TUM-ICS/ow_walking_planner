<?xml version="1.0" encoding="UTF-8"?>
<launch>

    <arg name="teleop_config" default="$(find ow_walking_planner)/config/teleop_tools.yaml" />
    <rosparam file="$(arg teleop_config)" command="load" />

    <node pkg="ow_walking_planner" type="key_teleop.py" name="key_teleop" output="screen"/>
    <node pkg="topic_tools" type="relay" name="cmd_vel_relay" args="key_vel walking_controller/cmd_vel" />  

</launch>
